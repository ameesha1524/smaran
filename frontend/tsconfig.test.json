{
  // Type-checks the unit tests and scripts, which use Node APIs. Kept out of
  // tsconfig.json so Node's globals never leak into browser code.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts", "scripts", "vitest.config.ts"],
  "exclude": []
}
