# Smaran — environment variables.
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is the only env
# file that belongs in git, and it must never hold a real secret.
#
# Generate secrets with:  openssl rand -base64 48

# ---------------------------------------------------------------------------
# Read by the code today
# ---------------------------------------------------------------------------

# Signs every access, refresh and device token. 32 bytes minimum. The backend
# refuses to start outside the dev, demo and test profiles without one.
SMARAN_JWT_SECRET=

# PostgreSQL, in every profile. The defaults match docker-compose.yml.
SMARAN_DB_URL=jdbc:postgresql://localhost:5432/smaran
SMARAN_DB_USER=smaran
SMARAN_DB_PASSWORD=

# Which Spring profile the backend container starts in: demo | prod.
SMARAN_PROFILE=demo

# Which rule turns low readings into an alert: TWO_CONSECUTIVE | SINGLE | CUSUM.
SMARAN_ALERT_RULE=TWO_CONSECUTIVE

# Redis is optional; its absence costs latency, not correctness.
SMARAN_REDIS_HOST=localhost
SMARAN_REDIS_PORT=6379

SMARAN_PORT=8080

# Comma-separated origins allowed to call the API from a browser.
SMARAN_CORS=http://localhost:5173

# Where uploaded family photos and voice notes are written.
SMARAN_STORAGE=./storage

# Notifications log instead of sending while these are empty.
SMARAN_FCM_KEY=
SMARAN_TWILIO_SID=
SMARAN_TWILIO_TOKEN=

# Frontend dev server only: where Vite proxies /api.
VITE_API_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# Planned (not read by any code yet; see docs/PLAN.md)
# ---------------------------------------------------------------------------

# Phase 2: the first admin account, created once on first boot.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Phase 4: journal analysis. Optional; without a key the endpoint returns no signals.
# ANTHROPIC_API_KEY=
# JOURNAL_MODEL=

# Phase 6: production compose.
# POSTGRES_PASSWORD=
# DOMAIN=
