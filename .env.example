# Smaran — environment variables.
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is the only env file that belongs in git,
# and it must never hold a real secret. Generate secrets with:  openssl rand -base64 48
#
# There are two sets of names, because there are two ways to run it:
#
#   1. DEVELOPMENT (docker-compose.yml, or the backend and frontend run from source). The backend reads the
#      SMARAN_* names directly. Every one has a safe local default; none is needed to try it.
#   2. PRODUCTION (deploy/docker-compose.prod.yml). The VM's `.env` holds the names in the second half of this
#      file; the compose file maps them to the SMARAN_* names the backend reads. The backend REFUSES TO START in
#      production if the JWT secret or the database password is missing or is one from this repository.
#
# In a production .env keep values to letters, digits and . _ - / + = (what `openssl rand -base64` makes);
# deploy.sh reads the file as shell, so a $ or a space in a value would be misread. Mode 600, owned by the
# deploy user.

# ===========================================================================
# 1. Development
# ===========================================================================

# Signs every access, refresh and device token. 32 bytes minimum. Outside the dev, demo and test profiles
# the backend refuses to start without a real one.
SMARAN_JWT_SECRET=

# PostgreSQL. The defaults match docker-compose.yml. Outside dev and demo the password must be a real one.
SMARAN_DB_URL=jdbc:postgresql://localhost:5432/smaran
SMARAN_DB_USER=smaran
SMARAN_DB_PASSWORD=

# Host port the compose database is published on (localhost only).
SMARAN_DB_PORT=5432

# Which Spring profile the backend container starts in: demo | prod.
SMARAN_PROFILE=demo

# Which rule turns low readings into an alert: TWO_CONSECUTIVE | SINGLE | CUSUM.
SMARAN_ALERT_RULE=TWO_CONSECUTIVE

SMARAN_PORT=8080

# Comma-separated origins allowed to call the API from a browser (only matters when the PWA is served from
# somewhere other than the API's own address, as the Vite dev server is).
SMARAN_CORS=http://localhost:5173

# Where uploaded family photos and voice notes are written.
SMARAN_STORAGE=./storage

# Notifications log instead of sending while these are empty.
SMARAN_FCM_KEY=
SMARAN_TWILIO_SID=
SMARAN_TWILIO_TOKEN=

# Keys the hash that stands for a patient in the dataset export (GET /api/admin/export/sessions.csv).
# Defaults to the JWT secret; set it to keep them apart. Changing it changes every hash.
SMARAN_EXPORT_SALT=

# The first administrator, created once on first start if none exists. Without them no administrator exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Journal entries are read for how they feel by a model the server calls. Without a key an entry is simply
# not read, nothing is stored, and the entry still saves on her tablet.
ANTHROPIC_API_KEY=
SMARAN_JOURNAL_MODEL=claude-haiku-4-5-20251001

# Frontend dev server only: where Vite proxies /api.
VITE_API_TARGET=http://localhost:8080

# Redis is no longer used by anything; the production compose has none.

# ===========================================================================
# 2. Production (the .env beside deploy/docker-compose.prod.yml on the VM)
# ===========================================================================

# The public name. Its A record must point at the VM; Caddy gets the certificate for it by itself.
DOMAIN=

# The GitHub account or organisation that owns the repository, lower case: images are ghcr.io/<owner>/smaran-*.
GHCR_OWNER=

# Required. The database's password and the signing secret.
POSTGRES_PASSWORD=
JWT_SECRET=

# Recommended: the dataset export's hash key (EXPORT_SALT) and the first administrator.
EXPORT_SALT=
# ADMIN_EMAIL and ADMIN_PASSWORD are read from the names above.

# Optional: the journal reading (ANTHROPIC_API_KEY above) and its model.
JOURNAL_MODEL=claude-haiku-4-5-20251001

# Optional: notifications.
FCM_KEY=
TWILIO_SID=
TWILIO_TOKEN=

# The smoke test (deploy/smoke.sh) signs in as a dedicated account it registers on first use. Required by deploy.sh.
SMOKE_PASSWORD=

# Backups: hour of the day (UTC) and how many to keep. Defaults shown.
# BACKUP_HOUR=02
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8

# Extra browser origins allowed to call the API directly (comma-separated). Only needed when the app is
# reached at an address other than https://DOMAIN, for example a non-standard port while trying the stack.
# CORS_ORIGINS=https://localhost,https://localhost:8443

# Only to try the production stack on one machine, where 80 and 443 are taken.
# HTTP_PORT=8088
# HTTPS_PORT=8443
